from __future__ import annotations

from collections.abc import Iterator
from typing import TYPE_CHECKING, Any, NoReturn, SupportsIndex, final, overload

import numpy as np
from numpy.typing import NDArray

from ._algebra import Algebra
from ._typing import _RealScalar

if TYPE_CHECKING:
    from ._array import ElementArray

@final
class Element:
    """An immutable real Cayley--Dickson element."""

    def __new__(cls, _forbidden: NoReturn, /) -> NoReturn: ...
    def __hash__(self) -> int: ...

    @property
    def algebra(self) -> Algebra: ...
    @property
    def dimension(self) -> int: ...
    @property
    def level(self) -> int: ...
    @property
    def real(self) -> float: ...
    @property
    def imag(self) -> Element: ...
    @property
    def coefficients(self) -> NDArray[np.float64]: ...
    @property
    def shape(self) -> tuple[int]: ...
    @property
    def dtype(self) -> np.dtype[np.float64]: ...
    @property
    def __array_priority__(self) -> float: ...

    def __len__(self) -> int: ...
    def __iter__(self) -> Iterator[float]: ...
    @overload
    def __getitem__(self, key: SupportsIndex, /) -> float: ...
    @overload
    def __getitem__(self, key: slice, /) -> tuple[float, ...]: ...
    def __bool__(self) -> bool: ...
    def __pos__(self) -> Element: ...
    def __neg__(self) -> Element: ...
    def __abs__(self) -> float: ...
    @overload
    def __add__(self, other: Element | _RealScalar, /) -> Element: ...
    @overload
    def __add__(self, other: ElementArray, /) -> ElementArray: ...
    def __radd__(self, other: _RealScalar, /) -> Element: ...
    @overload
    def __sub__(self, other: Element | _RealScalar, /) -> Element: ...
    @overload
    def __sub__(self, other: ElementArray, /) -> ElementArray: ...
    def __rsub__(self, other: _RealScalar, /) -> Element: ...
    @overload
    def __mul__(self, other: Element | _RealScalar, /) -> Element: ...
    @overload
    def __mul__(self, other: ElementArray, /) -> ElementArray: ...
    def __rmul__(self, other: _RealScalar, /) -> Element: ...
    def __truediv__(self, other: _RealScalar, /) -> Element: ...
    def __pow__(
        self, exponent: SupportsIndex, modulus: None = None, /
    ) -> Element: ...
    @overload
    def __eq__(  # type: ignore[overload-overlap]
        self, other: ElementArray, /
    ) -> NDArray[np.bool_]: ...
    @overload
    def __eq__(self, other: object, /) -> bool: ...
    @overload
    def __ne__(  # type: ignore[overload-overlap]
        self, other: ElementArray, /
    ) -> NDArray[np.bool_]: ...
    @overload
    def __ne__(self, other: object, /) -> bool: ...
    def __reduce__(self) -> tuple[Algebra, tuple[tuple[float, ...]]]: ...

    def copy(self) -> Element: ...
    def conjugate(self) -> Element: ...
    def imag_part(self) -> Element: ...
    def inner(self, other: Element, /) -> float: ...
    def norm_squared(self) -> float: ...
    def norm(self) -> float: ...
    def normalized(self) -> Element: ...
    def reciprocal(self) -> Element: ...
    def square(self) -> Element: ...
    def imag_cross(self, other: Element, /) -> Element: ...
    def commutator(self, other: Element, /) -> Element: ...
    def anticommutator(self, other: Element, /) -> Element: ...
    def associator(self, y: Element, z: Element, /) -> Element: ...
    def to_numpy(self, *, copy: bool = True) -> NDArray[np.float64]: ...
    def __array_ufunc__(
        self, ufunc: Any, method: str, *inputs: Any, **kwargs: Any
    ) -> Any: ...

def _version() -> str: ...
def _comparison_scalar(value: Any, /) -> Any: ...
def _element(algebra: Algebra, dimension: int, value: Any, /) -> Element: ...
def _scalar(algebra: Algebra, dimension: int, value: float, /) -> Element: ...
def _basis(algebra: Algebra, dimension: int, index: int, /) -> Element: ...
def _algorithm(name: str, dimension: int, /) -> int: ...
def _default_algorithm(dimension: int, /) -> str: ...
def _default_batch_algorithm(dimension: int, /) -> str: ...
def _multiply_element(algorithm: int, x: Element, y: Element, /) -> Element: ...
def _basis_product(
    dimension: int, left_index: int, right_index: int, /
) -> tuple[int, int]: ...
def _basis_lmul(index: int, value: Element, /) -> Element: ...
def _basis_rmul(value: Element, index: int, /) -> Element: ...
def _lop_commutator(
    a: Element, b: Element, x: Element, /
) -> Element: ...
def _rop_commutator(
    a: Element, b: Element, x: Element, /
) -> Element: ...
def _apply_unary_into(
    operation: int, out: Any, x: Any, dimension: int, /
) -> None: ...
def _apply_binary_into(
    operation: int, out: Any, x: Any, y: Any, dimension: int, /
) -> None: ...
def _apply_multiply_into(
    algorithm: int, out: Any, x: Any, y: Any, dimension: int, /
) -> None: ...
def _apply_scalar_into(
    operation: int, out: Any, x: Any, y: Any | None, dimension: int, /
) -> None: ...
def _apply_associator_into(
    out: Any, x: Any, y: Any, z: Any, dimension: int, /
) -> None: ...
def _apply_basis_into(
    left: bool, index: int, out: Any, x: Any, dimension: int, /
) -> None: ...
def _apply_operator_into(
    left: bool, out: Any, a: Any, b: Any, x: Any, dimension: int, /
) -> None: ...

_UNARY_CONJUGATE: int
_UNARY_IMAG_PART: int
_UNARY_NORMALIZE: int
_UNARY_RECIPROCAL: int
_UNARY_SQUARE: int
_BINARY_MULTIPLY: int
_BINARY_IMAG_CROSS: int
_BINARY_COMMUTATOR: int
_BINARY_ANTICOMMUTATOR: int
_SCALAR_INNER: int
_SCALAR_NORM_SQUARED: int
_SCALAR_NORM: int
