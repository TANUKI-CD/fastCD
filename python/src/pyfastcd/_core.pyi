from __future__ import annotations

from collections.abc import Iterator
from typing import (
    TYPE_CHECKING,
    Any,
    Generic,
    NoReturn,
    SupportsIndex,
    TypeAlias,
    final,
    overload,
)

import numpy as np
from numpy.typing import NDArray
from typing_extensions import TypeVar

from ._algebra import Algebra
from ._field import FiniteField
from ._typing import _RealScalar

if TYPE_CHECKING:
    from ._array import ElementArray

_D = TypeVar("_D", bound=np.generic, default=np.float64)
_S = TypeVar("_S", default=float)
_P = TypeVar("_P", default=Algebra)
_H = TypeVar("_H", bound=tuple[int, ...], default=tuple[int])
_FieldArray: TypeAlias = (
    "ElementArray[np.uint32, Any, Any, FiniteField, tuple[int, ...]]"
)

@final
class Element(Generic[_D, _S, _P, _H]):
    """An immutable Cayley--Dickson element or coefficient-field scalar."""

    def __new__(cls, _forbidden: NoReturn, /) -> NoReturn: ...
    def __hash__(self) -> int: ...
    def __buffer__(self, flags: int, /) -> memoryview: ...
    @property
    def algebra(self) -> _P: ...
    @property
    def dimension(self) -> int: ...
    @property
    def level(self) -> int: ...
    @property
    def real(self) -> _S: ...
    @property
    def imag(self) -> Element[_D, _S, _P, _H]: ...
    @property
    def coefficients(self) -> NDArray[_D]: ...
    @property
    def shape(self) -> _H: ...
    @property
    def dtype(self) -> np.dtype[_D]: ...
    @property
    def __array_priority__(self) -> float: ...
    def __len__(self) -> int: ...
    def __iter__(self) -> Iterator[_S]: ...
    @overload
    def __getitem__(self, key: SupportsIndex, /) -> _S: ...
    @overload
    def __getitem__(self, key: slice, /) -> tuple[_S, ...]: ...
    def __bool__(self) -> bool: ...
    def __pos__(self) -> Element[_D, _S, _P, _H]: ...
    def __neg__(self) -> Element[_D, _S, _P, _H]: ...
    def __abs__(self) -> float: ...
    @overload
    def __add__(
        self,
        other: Element[_D, _S, _P, _H]
        | _RealScalar
        | complex
        | Element[Any, Any, FiniteField, Any],
        /,
    ) -> Element[_D, _S, _P, _H]: ...
    @overload
    def __add__(
        self, other: ElementArray[_D, _S, Any, Any, _H], /
    ) -> ElementArray[_D, _S, Any, Any, _H]: ...
    def __radd__(
        self, other: _RealScalar | complex | Element[Any, Any, FiniteField, Any], /
    ) -> Element[_D, _S, _P, _H]: ...
    @overload
    def __sub__(
        self,
        other: Element[_D, _S, _P, _H]
        | _RealScalar
        | complex
        | Element[Any, Any, FiniteField, Any],
        /,
    ) -> Element[_D, _S, _P, _H]: ...
    @overload
    def __sub__(
        self, other: ElementArray[_D, _S, Any, Any, _H], /
    ) -> ElementArray[_D, _S, Any, Any, _H]: ...
    def __rsub__(
        self, other: _RealScalar | complex | Element[Any, Any, FiniteField, Any], /
    ) -> Element[_D, _S, _P, _H]: ...
    @overload
    def __mul__(
        self,
        other: Element[_D, _S, _P, _H]
        | _RealScalar
        | complex
        | Element[Any, Any, FiniteField, Any],
        /,
    ) -> Element[_D, _S, _P, _H]: ...
    @overload
    def __mul__(
        self, other: ElementArray[_D, _S, Any, Any, _H] | _FieldArray, /
    ) -> ElementArray[_D, _S, Any, Any, _H]: ...
    @overload
    def __rmul__(
        self, other: _RealScalar | complex | Element[Any, Any, FiniteField, Any], /
    ) -> Element[_D, _S, _P, _H]: ...
    @overload
    def __rmul__(self, other: _FieldArray, /) -> ElementArray[_D, _S, Any, Any, _H]: ...
    @overload
    def __truediv__(
        self, other: _RealScalar | complex | Element[Any, Any, FiniteField, Any], /
    ) -> Element[_D, _S, _P, _H]: ...
    @overload
    def __truediv__(
        self, other: _FieldArray, /
    ) -> ElementArray[_D, _S, Any, Any, _H]: ...
    def __rtruediv__(
        self, other: _RealScalar | complex | Element[Any, Any, FiniteField, Any], /
    ) -> Element[_D, _S, _P, _H]: ...
    def __pow__(
        self, exponent: SupportsIndex, modulus: None = None, /
    ) -> Element[_D, _S, _P, _H]: ...
    @overload
    def __eq__(  # type: ignore[overload-overlap]
        self, other: ElementArray[_D, _S, Any, Any, _H], /
    ) -> NDArray[np.bool_]: ...
    @overload
    def __eq__(self, other: object, /) -> bool: ...
    @overload
    def __ne__(  # type: ignore[overload-overlap]
        self, other: ElementArray[_D, _S, Any, Any, _H], /
    ) -> NDArray[np.bool_]: ...
    @overload
    def __ne__(self, other: object, /) -> bool: ...
    @overload
    def __reduce__(
        self: Element[np.float64, float, Algebra],
    ) -> tuple[Algebra, tuple[tuple[float, ...]]]: ...
    @overload
    def __reduce__(self) -> tuple[Any, tuple[Any, ...]]: ...
    def copy(self) -> Element[_D, _S, _P, _H]: ...
    def conjugate(self) -> Element[_D, _S, _P, _H]: ...
    def imag_part(self) -> Element[_D, _S, _P, _H]: ...
    def inner(self, other: Element[_D, _S, _P, _H], /) -> _S: ...
    def norm_squared(self) -> _S: ...
    def quadratic_norm(self) -> _S: ...
    def norm(self) -> float: ...
    def normalized(self) -> Element[_D, _S, _P, _H]: ...
    def reciprocal(self) -> Element[_D, _S, _P, _H]: ...
    def square(self) -> Element[_D, _S, _P, _H]: ...
    def imag_cross(
        self, other: Element[_D, _S, _P, _H], /
    ) -> Element[_D, _S, _P, _H]: ...
    def commutator(
        self, other: Element[_D, _S, _P, _H], /
    ) -> Element[_D, _S, _P, _H]: ...
    def anticommutator(
        self, other: Element[_D, _S, _P, _H], /
    ) -> Element[_D, _S, _P, _H]: ...
    def associator(
        self, y: Element[_D, _S, _P, _H], z: Element[_D, _S, _P, _H], /
    ) -> Element[_D, _S, _P, _H]: ...
    def to_numpy(self, *, copy: bool = True) -> NDArray[_D]: ...
    def __array_ufunc__(
        self, ufunc: Any, method: str, *inputs: Any, **kwargs: Any
    ) -> Any: ...

def _version() -> str: ...
def _comparison_scalar(value: Any, /) -> Any: ...
def _element(algebra: Algebra, dimension: int, value: Any, /) -> Element: ...
def _scalar(algebra: Algebra, dimension: int, value: float, /) -> Element: ...
def _basis(algebra: Algebra, dimension: int, index: int, /) -> Element: ...
def _algorithm(name: str, dimension: int, /) -> int: ...
def _default_algorithm(dimension: int, /) -> str: ...
def _default_batch_algorithm(dimension: int, /) -> str: ...
def _multiply_element(algorithm: int, x: Element, y: Element, /) -> Element: ...
def _basis_product(
    dimension: int, left_index: int, right_index: int, /
) -> tuple[int, int]: ...
def _basis_lmul(index: int, value: Element, /) -> Element: ...
def _basis_rmul(value: Element, index: int, /) -> Element: ...
def _lop_commutator(a: Element, b: Element, x: Element, /) -> Element: ...
def _rop_commutator(a: Element, b: Element, x: Element, /) -> Element: ...
def _apply_unary_into(operation: int, out: Any, x: Any, dimension: int, /) -> None: ...
def _apply_binary_into(
    operation: int, out: Any, x: Any, y: Any, dimension: int, /
) -> None: ...
def _apply_multiply_into(
    algorithm: int, out: Any, x: Any, y: Any, dimension: int, /
) -> None: ...
def _apply_scalar_into(
    operation: int, out: Any, x: Any, y: Any | None, dimension: int, /
) -> None: ...
def _apply_associator_into(
    out: Any, x: Any, y: Any, z: Any, dimension: int, /
) -> None: ...
def _apply_basis_into(
    left: bool, index: int, out: Any, x: Any, dimension: int, /
) -> None: ...
def _apply_operator_into(
    left: bool, out: Any, a: Any, b: Any, x: Any, dimension: int, /
) -> None: ...

_UNARY_CONJUGATE: int
_UNARY_IMAG_PART: int
_UNARY_NORMALIZE: int
_UNARY_RECIPROCAL: int
_UNARY_SQUARE: int
_BINARY_MULTIPLY: int
_BINARY_IMAG_CROSS: int
_BINARY_COMMUTATOR: int
_BINARY_ANTICOMMUTATOR: int
_SCALAR_INNER: int
_SCALAR_NORM_SQUARED: int
_SCALAR_NORM: int

def _extended_element(
    parent: Any, payload: bytes, shape: tuple[int, ...], complex: bool
) -> Element: ...
