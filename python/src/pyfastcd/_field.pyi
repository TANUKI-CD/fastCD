from __future__ import annotations

from typing import (
    Any,
    Final,
    TypeAlias,
    final,
)

import numpy as np

from ._array import ElementArray
from ._core import Element

_FieldScalar: TypeAlias = "Element[np.uint32, Any, FiniteField, tuple[int, ...]]"
_FieldArray: TypeAlias = (
    "ElementArray[np.uint32, _FieldScalar, Any, FiniteField, tuple[int, ...]]"
)

@final
class FiniteField:
    char: Final[int]
    deg: Final[int]
    order: Final[int]
    modulus: Final[tuple[int, ...]]
    _native: Any
    _ctx: Any
    def __new__(cls, *, char: Any, deg: Any = 1) -> FiniteField: ...
    def __init__(self, *, char: Any, deg: Any = 1) -> None: ...
    def __init_subclass__(cls, **kwargs: Any) -> None: ...
    def __setattr__(self, name: str, value: Any) -> None: ...
    def __delattr__(self, name: str) -> None: ...
    @classmethod
    def from_modulus(cls, *, char: Any, modulus: Any) -> FiniteField: ...
    @property
    def dtype(self) -> np.dtype[np.uint32]: ...
    @property
    def coefficient_shape(self) -> tuple[int, ...]: ...
    @property
    def dimension(self) -> int: ...
    @property
    def level(self) -> int: ...
    @property
    def field(self) -> FiniteField: ...
    def __repr__(self) -> str: ...
    def __reduce__(self) -> Any: ...
    def __call__(self, value: Any = 0) -> _FieldScalar: ...
    def scalar(self, value: Any) -> _FieldScalar: ...
    def zero(self) -> _FieldScalar: ...
    def one(self) -> _FieldScalar: ...
    def array(self, values: Any) -> _FieldArray: ...
    def asarray(self, values: Any, *, copy: bool | None = None) -> _FieldArray: ...
    def multiply(
        self, x: Any, y: Any, *, out: Any = None
    ) -> _FieldScalar | _FieldArray: ...
