from __future__ import annotations

from collections.abc import Iterator
from typing import (
    Any,
    Generic,
    NoReturn,
    SupportsIndex,
    TypeAlias,
    overload,
)

import numpy as np
from numpy.typing import NDArray
from typing_extensions import TypeVar

from ._algebra import Algebra
from ._core import Element
from ._field import FiniteField
from ._typing import _RealScalar

_D = TypeVar("_D", bound=np.generic, default=np.float64)
_S = TypeVar("_S", default=float)
_R = TypeVar("_R", default=NDArray[np.float64])
_P = TypeVar("_P", default=Algebra)
_H = TypeVar("_H", bound=tuple[int, ...], default=tuple[int])
_FieldScalar = Element[np.uint32, Any, FiniteField, tuple[int, ...]]
_FieldArray: TypeAlias = (
    "ElementArray[np.uint32, _FieldScalar, Any, FiniteField, tuple[int, ...]]"
)

class ElementArray(Generic[_D, _S, _R, _P, _H]):
    def __init__(self, _forbidden: NoReturn, /) -> None: ...
    __array_priority__: float
    @classmethod
    def _from_coefficients(
        cls, algebra: Algebra[_D, _S, _R, _H], coefficients: np.ndarray[Any, Any]
    ) -> ElementArray[_D, _S, _R, _P, _H]: ...
    @property
    def algebra(self) -> _P: ...
    @property
    def dimension(self) -> int: ...
    @property
    def level(self) -> int: ...
    @property
    def dtype(self) -> np.dtype[_D]: ...
    @property
    def shape(self) -> tuple[int, ...]: ...
    @property
    def batch_shape(self) -> tuple[int, ...]: ...
    @property
    def coefficients(self) -> np.ndarray[Any, np.dtype[_D]]: ...
    @property
    def real(self) -> _R: ...
    @property
    def imag(self) -> ElementArray[_D, _S, _R, _P, _H]: ...
    def __array__(
        self, dtype: Any | None = None, copy: bool | None = None
    ) -> np.ndarray[Any, Any]: ...
    def __dlpack__(
        self,
        *,
        stream: Any = None,
        max_version: tuple[int, int] | None = None,
        dl_device: tuple[int, int] | None = None,
        copy: bool | None = None,
    ) -> Any: ...
    def __dlpack_device__(self) -> tuple[int, int]: ...
    def copy(self) -> ElementArray[_D, _S, _R, _P, _H]: ...
    def __copy__(self) -> ElementArray[_D, _S, _R, _P, _H]: ...
    def __deepcopy__(
        self, memo: dict[int, Any]
    ) -> ElementArray[_D, _S, _R, _P, _H]: ...
    def __reduce__(self) -> tuple[Any, tuple[Any, ...]]: ...
    def to_numpy(self, *, copy: bool = True) -> np.ndarray[Any, Any]: ...
    def __getitem__(
        self, key: Any
    ) -> Element[_D, _S, _P, _H] | ElementArray[_D, _S, _R, _P, _H]: ...
    def __len__(self) -> int: ...
    def __iter__(
        self,
    ) -> Iterator[Element[_D, _S, _P, _H] | ElementArray[_D, _S, _R, _P, _H]]: ...
    def __setitem__(self, key: Any, value: Any) -> None: ...
    def __bool__(self) -> bool: ...
    def __pos__(self) -> ElementArray[_D, _S, _R, _P, _H]: ...
    def __neg__(self) -> ElementArray[_D, _S, _R, _P, _H]: ...
    def __add__(
        self,
        other: Element[_D, _S, _P, _H]
        | ElementArray[_D, _S, _R, _P, _H]
        | _RealScalar
        | complex
        | _FieldScalar,
    ) -> ElementArray[_D, _S, _R, _P, _H]: ...
    def __radd__(
        self, other: Element[_D, _S, _P, _H] | _RealScalar | complex | _FieldScalar
    ) -> ElementArray[_D, _S, _R, _P, _H]: ...
    def __sub__(
        self,
        other: Element[_D, _S, _P, _H]
        | ElementArray[_D, _S, _R, _P, _H]
        | _RealScalar
        | complex
        | _FieldScalar,
    ) -> ElementArray[_D, _S, _R, _P, _H]: ...
    def __rsub__(
        self, other: Element[_D, _S, _P, _H] | _RealScalar | complex | _FieldScalar
    ) -> ElementArray[_D, _S, _R, _P, _H]: ...
    def __mul__(
        self,
        other: Element[_D, _S, _P, _H]
        | ElementArray[_D, _S, _R, _P, _H]
        | _RealScalar
        | complex
        | _FieldScalar,
    ) -> ElementArray[_D, _S, _R, _P, _H]: ...
    def __rmul__(
        self, other: Element[_D, _S, _P, _H] | _RealScalar | complex | _FieldScalar
    ) -> ElementArray[_D, _S, _R, _P, _H]: ...
    def __truediv__(
        self, other: _RealScalar | complex | _FieldScalar
    ) -> ElementArray[_D, _S, _R, _P, _H]: ...
    def __pow__(
        self, exponent: SupportsIndex, modulus: None = None
    ) -> ElementArray[_D, _S, _R, _P, _H]: ...
    def __abs__(self) -> np.ndarray[Any, np.dtype[_D]]: ...
    @overload
    def __eq__(  # type: ignore[overload-overlap]
        self,
        other: Element[_D, _S, _P, _H]
        | ElementArray[_D, _S, _R, _P, _H]
        | _RealScalar
        | complex
        | _FieldScalar,
    ) -> np.ndarray[Any, np.dtype[np.bool_]]: ...
    @overload
    def __eq__(self, other: object) -> bool: ...
    @overload
    def __ne__(  # type: ignore[overload-overlap]
        self,
        other: Element[_D, _S, _P, _H]
        | ElementArray[_D, _S, _R, _P, _H]
        | _RealScalar
        | complex
        | _FieldScalar,
    ) -> np.ndarray[Any, np.dtype[np.bool_]]: ...
    @overload
    def __ne__(self, other: object) -> bool: ...
    def conjugate(self) -> ElementArray[_D, _S, _R, _P, _H]: ...
    def imag_part(self) -> ElementArray[_D, _S, _R, _P, _H]: ...
    def normalized(self) -> ElementArray[_D, _S, _R, _P, _H]: ...
    def reciprocal(self) -> ElementArray[_D, _S, _R, _P, _H]: ...
    def square(self) -> ElementArray[_D, _S, _R, _P, _H]: ...
    def inner(self, other: Any) -> _R: ...
    def norm_squared(self) -> _R: ...
    def quadratic_norm(self) -> _R: ...
    def norm(self) -> np.ndarray[Any, np.dtype[_D]]: ...
    def imag_cross(self, other: Any) -> ElementArray[_D, _S, _R, _P, _H]: ...
    def commutator(self, other: Any) -> ElementArray[_D, _S, _R, _P, _H]: ...
    def anticommutator(self, other: Any) -> ElementArray[_D, _S, _R, _P, _H]: ...
    def associator(self, y: Any, z: Any) -> ElementArray[_D, _S, _R, _P, _H]: ...
    def __array_ufunc__(
        self, ufunc: Any, method: str, *inputs: Any, **kwargs: Any
    ) -> Any: ...

def _dlpack_pair(value: Any, *, name: str) -> tuple[int, int] | None: ...
def _is_real_scalar(value: Any) -> bool: ...
def _validate_source_dtype(array: np.ndarray[Any, Any]) -> None: ...
def _layout_is_compatible(array: np.ndarray[Any, Any], dimension: int) -> bool: ...
def _from_dlpack_if_needed(values: Any, *, copy: bool | None) -> Any: ...
def _coerce_coefficients(
    algebra: Algebra, values: Any, *, copy: bool | None
) -> np.ndarray[Any, np.dtype[np.float64]]: ...
def _array_from_values(
    algebra: Algebra, values: Any, *, copy: bool | None
) -> ElementArray: ...
def _element_array_from_pickle(algebra: Algebra, coefficients: Any) -> ElementArray: ...
def _strict_operand(algebra: Algebra, value: Any) -> np.ndarray[Any, Any] | None: ...
def _general_operand(algebra: Algebra, value: Any) -> np.ndarray[Any, Any]: ...
def _broadcast_coefficients(
    algebra: Algebra, *operands: np.ndarray[Any, Any]
) -> tuple[tuple[int, ...], list[np.ndarray[Any, Any]]]: ...
def _element_output(
    algebra: Algebra,
    full_shape: tuple[int, ...],
    out: Any | None,
    inputs: tuple[np.ndarray[Any, Any], ...],
) -> tuple[np.ndarray[Any, Any], ElementArray]: ...
def _unary(algebra: Algebra, value: Any, operation: int) -> ElementArray: ...
def _binary(
    algebra: Algebra,
    left: Any,
    right: Any,
    operation: int,
    *,
    out: Any | None = None,
    allow_array_like: bool = False,
    algorithm: int | None = None,
) -> ElementArray: ...
def _multiply(
    algebra: Algebra,
    left: Any,
    right: Any,
    *,
    out: Any | None = None,
    allow_array_like: bool = False,
    algorithm: int | None = None,
) -> Any: ...
def _coordinate_add(
    array: ElementArray, other: Any, *, subtract: bool, reflected: bool
) -> Any: ...
def _coordinate_equal(array: ElementArray, other: Any, *, invert: bool) -> Any: ...
def _scalar_unary(
    algebra: Algebra, value: Any, operation: int
) -> np.ndarray[Any, Any]: ...
def _scalar_binary(
    algebra: Algebra, left: Any, right: Any, operation: int
) -> np.ndarray[Any, Any]: ...
def _associator(algebra: Algebra, x: Any, y: Any, z: Any) -> ElementArray: ...
def _basis_action(
    algebra: Algebra, index: int, x: Any, *, left: bool, out: Any | None
) -> ElementArray: ...
def _operator_commutator(
    algebra: Algebra, a: Any, b: Any, x: Any, *, left: bool, out: Any | None
) -> ElementArray: ...
